{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/weekly-notify.py": { "excludeFiles": "{public/**,supabase/**,scripts/**,.claude/**,.vscode/**,*.pdf,*.md,*.bat,*.example.json,LICENSE}", "includeFiles": "{weekly_notify,sheet_sync}.py", "maxDuration": 60 },
    "api/access-request-notify.py": { "excludeFiles": "{public/**,supabase/**,scripts/**,.claude/**,.vscode/**,*.pdf,*.md,*.bat,*.example.json,LICENSE}", "includeFiles": "{access_request_notify,meeting_notify,weekly_notify,sheet_sync}.py", "maxDuration": 60 },
    "api/sheet-sync.py": { "excludeFiles": "{public/**,supabase/**,scripts/**,.claude/**,.vscode/**,*.pdf,*.md,*.bat,*.example.json,LICENSE}", "includeFiles": "sheet_sync.py", "maxDuration": 60 },
    "api/meeting-notify.py": { "excludeFiles": "{public/**,supabase/**,scripts/**,.claude/**,.vscode/**,*.pdf,*.md,*.bat,*.example.json,LICENSE}", "includeFiles": "{meeting_notify,weekly_notify,sheet_sync}.py", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/weekly-notify", "schedule": "0 11 * * 1" },
    { "path": "/api/access-request-notify", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://rutwtconjydmikegbtsg.supabase.co wss://rutwtconjydmikegbtsg.supabase.co https://cdn.jsdelivr.net https://docs.google.com https://drive.google.com https://*.googleusercontent.com; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
